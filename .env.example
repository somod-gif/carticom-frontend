# ============================================================
# CARTICOM FRONTEND — Environment Variables
# ============================================================
# Copy to `.env.local` for local development (git-ignored), or set these in
# Vercel → Project → Settings → Environment Variables for deployments.
#
# Only variables that the code actually reads are listed here.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time —
# changing one requires a new deployment, not just a restart.
# ------------------------------------------------------------

# ─── Application URL (REQUIRED in production) ────────────────
# Public. Canonical public URL of the web app. Used for metadata/OpenGraph,
# robots.txt, sitemap.xml and share links. Read via lib/site-config.ts.
#   Production: https://carticom.cv
#   Local:      http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Backend API URL (REQUIRED in production) ────────────────
# Public. Origin of the REST API consumed by lib/axios.ts.
#
# Do NOT append /api/v1 — every service path already includes it
# (e.g. /api/v1/auth/login). Adding it here yields the broken
# https://host/api/v1/api/v1/... URLs.
#
#   Production: https://carticom-backend.pxxlspace.cv
#   Local:      http://localhost:8080
#
# Leave EMPTY to call the API on the app's own origin. In that mode the
# `/api/:path*` rewrite in vercel.json proxies requests to the backend
# (same-origin, so no CORS preflight and first-party auth cookies).
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Analytics (optional) ────────────────────────────────────
# Public. When "true" AND NEXT_PUBLIC_GA_MEASUREMENT_ID is set, Google
# Analytics page views are sent. Defaults to off.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Public. Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Sabilytics (optional) ───────────────────────────────────
# Public. Sabilytics product analytics for the public site. The tracking
# script (https://www.sabilytics.com/script.js) self-reports page views and
# Web Vitals. Defaults target the production Carticom site, so it works with
# no configuration; set the site id to empty to disable it.
NEXT_PUBLIC_SABILYTICS_SITE=4gpo6ob9cmxc
# Public. Domain label reported to Sabilytics (informational).
NEXT_PUBLIC_SABILYTICS_DOMAIN=carticom.cv

# ─── Error monitoring (optional) ─────────────────────────────
# Public. Sentry DSN used by sentry.client.config.ts / edge / server.
NEXT_PUBLIC_SENTRY_DSN=
# Public. Sentry environment label. Vercel sets NEXT_PUBLIC_VERCEL_ENV
# automatically (production / preview / development).
NEXT_PUBLIC_VERCEL_ENV=

# ─── Sentry build-time upload (optional, SECRET) ─────────────
# Secret. Only needed to upload source maps / create releases during the
# Vercel build. Never expose these to the browser.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Server-side Sentry DSN (used by sentry.server.config.ts).
SENTRY_DSN=

# ─── End-to-end tests (optional) ─────────────────────────────
# Optional. Base URL targeted by Playwright. Defaults to https://carticom.cv
# PLAYWRIGHT_BASE_URL=http://localhost:3000
